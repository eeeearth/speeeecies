{
  "description": "Body plans for the block-mesh look (format v0.1). `parts` are the boxes the previewer and the host generate for each plan, parent first; `extra_parts`, `part_colors` and pose keyframes may name them. `defaults` are used for omitted proportions. `poses` lists the poses with a built-in animation. `default_colors` gives each part's palette slot.",
  "locomotion_to_pose": {
    "Walk": "walk",
    "Trot": "trot",
    "Gallop": "gallop",
    "Hop": "hop",
    "Slither": "slither",
    "Swim": "swim",
    "Fly": "fly",
    "Glide": "glide"
  },
  "plans": {
    "quadruped": {
      "parts": [
        "body",
        "neck",
        "head",
        "snout",
        "ear_left",
        "ear_right",
        "leg_front_left",
        "leg_front_right",
        "leg_rear_left",
        "leg_rear_right",
        "tail"
      ],
      "defaults": {
        "torso_aspect": 2.0,
        "leg_length_ratio": 0.45,
        "head_scale": 0.7,
        "neck_angle_deg": 30,
        "tail_ratio": 0.5,
        "ear_ratio": 0.3,
        "beak_ratio": 0.5,
        "girth_ratio": 0.8
      },
      "poses": [
        "idle",
        "walk",
        "trot",
        "gallop",
        "rest",
        "swim"
      ],
      "default_colors": {
        "body": "body",
        "neck": "body",
        "head": "body",
        "snout": "belly",
        "ear_*": "body",
        "leg_*": "body",
        "tail": "body"
      }
    },
    "hopper": {
      "parts": [
        "body",
        "neck",
        "head",
        "snout",
