{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-killdeer-ground-forager-v1",
  "kind": "bt",
  "description": "A ground-foraging plover that walks to feed, nests in a ground scrape, rests at night, and escapes threats by flight.",
  "params": {
    "food_tag": "invertebrate",
    "call": "call"
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {"cond": {"threat_within_m": 12}},
          {"act": {"do": "alarm", "call": "${call}"}},
          {"act": {"do": "take_off"}},
          {"act": {"do": "flee", "gait": "fly"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"is_day": false}},
          {"act": {"do": "rest", "at": "shelter"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "nest", "gt": 0.5}},
          {"cond": {"month_in": [3, 4, 5, 6, 7]}},
          {"cond": {"nest_site_within_m": 30}},
          {"act": {"do": "build_nest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"act": {"do": "eat_nearest", "tag": "${food_tag}", "gait": "walk"}}
        ]
      },
      {"act": {"do": "wander", "gait": "walk"}}
    ]
  }
}
