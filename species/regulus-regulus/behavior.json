{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-regulus-canopy-forager-v1",
  "kind": "bt",
  "description": "Goldcrest: flee to a perch when threatened, roost in shelter at night, sing around dawn, and forage for invertebrates while hopping through tree foliage. The feeding action has no ground-landing step.",
  "params": {
    "flee_m": 5,
    "food_tag": "invertebrate",
    "song": "song",
    "alarm": "alarm",
    "song_cooldown_s": 12
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {"cond": {"threat_within_m": "${flee_m}"}},
          {"act": {"do": "alarm", "call": "${alarm}"}},
          {"act": {"do": "take_off"}},
          {"act": {"do": "fly_to_nearest", "tag": "perch"}},
          {"act": {"do": "perch_nearest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"is_day": false}},
          {"act": {"do": "perch_nearest", "tag": "shelter"}},
          {"act": {"do": "rest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"sun_elevation_between_deg": [-6, 12]}},
          {"cond": {"perch_within_m": 30}},
          {"act": {"do": "perch_nearest"}},
          {"cooldown_s": "${song_cooldown_s}", "child": {"act": {"do": "sing", "call": "${song}"}}}
        ]
      },
      {
        "sequence": [
          {"cond": {"is_day": true}},
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"act": {"do": "eat_nearest", "tag": "${food_tag}", "gait": "hop"}}
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {"act": {"do": "take_off"}},
            {"act": {"do": "fly_to_nearest", "tag": "perch"}},
            {"act": {"do": "perch_nearest"}}
          ]
        }
      },
      {"act": {"do": "idle"}}
    ]
  }
}
