{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-columbia-spotted-frog-v1",
  "kind": "fsm",
  "description": "Columbia spotted frog: uses permanent water and nearby cover, forages and moves during suitable conditions by day or night, calls near water during the northeastern Oregon breeding season, freezes then hops from threats.",
  "params": {
    "flee_m": 2,
    "freeze_m": 5,
    "food_tag": "invertebrate",
    "call": "croak",
    "min_temp_c": 3,
    "max_temp_c": 28,
    "call_m1": 3,
    "call_m2": 6
  },
  "initial": "hide",
  "states": {
    "hide": {
      "action": {
        "do": "hide_nearest"
      },
      "min_dwell_s": 20
    },
    "rest": {
      "action": {
        "do": "rest"
      },
      "min_dwell_s": 10
    },
    "forage": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "walk"
      }
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "walk"
      }
    },
    "call": {
      "action": {
        "do": "sing",
        "call": "${call}"
      },
      "min_dwell_s": 2
    },
    "freeze": {
      "action": {
        "do": "emote",
        "kind": "freeze"
      },
      "min_dwell_s": 2
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "hop"
      },
      "min_dwell_s": 2
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "freeze",
      "when": {
        "all": [
          {
            "threat_within_m": "${freeze_m}"
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 50
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          }
        ]
      },
      "priority": 45
    },
    {
      "from": "touched",
      "to": "rest",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "freeze",
      "to": "rest",
      "when": {
        "not": {
          "threat_within_m": "${freeze_m}"
        }
      }
    },
    {
      "from": "flee",
      "to": "hide",
      "when": {
        "not": {
          "threat_within_m": "${freeze_m}"
        }
      }
    },
    {
      "from": "hide",
      "to": "rest",
      "when": {
        "temperature_between_c": [
          "${min_temp_c}",
          "${max_temp_c}"
        ]
      }
    },
    {
      "from": "rest",
      "to": "hide",
      "when": {
        "not": {
          "temperature_between_c": [
            "${min_temp_c}",
            "${max_temp_c}"
          ]
        }
      }
    },
    {
      "from": "rest",
      "to": "call",
      "when": {
        "all": [
          {
            "month_in": [
              "${call_m1}",
              "${call_m2}"
            ]
          },
          {
            "water_within_m": 5
          },
          {
            "chance": 0.1
          }
        ]
      }
    },
    {
      "from": "call",
      "to": "rest",
      "when": {
        "chance": 0.3
      }
    },
    {
      "from": "rest",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.4
          },
          {
            "food_within_m": 8,
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "rest",
      "to": "wander",
      "when": {
        "chance": 0.1
      }
    },
    {
      "from": "wander",
      "to": "rest",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "forage",
      "to": "rest",
      "when": {
        "need": "hunger",
        "lt": 0.15
      }
    }
  ]
}
