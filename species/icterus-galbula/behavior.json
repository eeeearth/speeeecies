{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-icterus-galbula-v1",
  "kind": "bt",
  "description": "Baltimore oriole: canopy-foraging icterid. Alarm and flee to a perch when threatened, roost in cover at night, and feed on whichever of insects, fruit or nectar is nearest. No nesting or song branch: the supported Costa Rica region is outside the breeding season, and a shared month calendar cannot express that region alone.",
  "params": {
    "flee_m": 6,
    "alarm": "alarm",
    "food_within_m": 30
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "alarm",
              "call": "${alarm}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "fly_to_nearest",
              "tag": "perch"
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_touch": true
            }
          },
          {
            "act": {
              "do": "tolerate_touch"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "fear",
              "gt": 0.2
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_offer": "food"
            }
          },
          {
            "cond": {
              "need": "fear",
              "lt": 0.2
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "accept_offer",
              "tag": "fruit"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "perch_nearest",
              "tag": "shelter"
            }
          },
          {
            "act": {
              "do": "rest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.4
            }
          },
          {
            "selector": [
              {
                "sequence": [
                  {
                    "cond": {
                      "food_within_m": "${food_within_m}",
                      "tag": "invertebrate"
                    }
                  },
                  {
                    "act": {
                      "do": "land"
                    }
                  },
                  {
                    "act": {
                      "do": "eat_nearest",
                      "tag": "invertebrate",
                      "gait": "hop"
                    }
                  }
                ]
              },
              {
                "sequence": [
                  {
                    "cond": {
                      "food_within_m": "${food_within_m}",
                      "tag": "fruit"
                    }
                  },
                  {
                    "act": {
                      "do": "land"
                    }
                  },
                  {
                    "act": {
                      "do": "eat_nearest",
                      "tag": "fruit",
                      "gait": "hop"
                    }
                  }
                ]
              },
              {
                "sequence": [
                  {
                    "cond": {
                      "food_within_m": "${food_within_m}",
                      "tag": "nectar"
                    }
                  },
                  {
                    "act": {
                      "do": "land"
                    }
                  },
                  {
                    "act": {
                      "do": "eat_nearest",
                      "tag": "nectar",
                      "gait": "hop"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {
              "act": {
                "do": "take_off"
              }
            },
            {
              "act": {
                "do": "fly_to_nearest",
                "tag": "perch"
              }
            },
            {
              "act": {
                "do": "perch_nearest"
              }
            }
          ]
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
