{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-uta-stansburiana-v1",
  "kind": "fsm",
  "description": "Small terrestrial lizard: forages on warm days, rests under cover in darkness or unsuitable temperatures, and runs from threats.",
  "params": {"food_tag": "invertebrate", "flee_m": 3, "calm_m": 8, "food_m": 10, "min_temp_c": 12, "max_temp_c": 42},
  "initial": "shelter",
  "states": {
    "shelter": {"action": {"do": "hide_nearest"}, "min_dwell_s": 10},
    "idle": {"action": {"do": "idle"}},
    "wander": {"action": {"do": "wander", "gait": "walk"}},
    "forage": {"action": {"do": "eat_nearest", "tag": "${food_tag}", "gait": "walk"}},
    "flee": {"action": {"do": "flee", "gait": "walk"}, "min_dwell_s": 2}
  },
  "transitions": [
    {"from": "*", "to": "flee", "when": {"threat_within_m": "${flee_m}"}, "priority": 100},
    {"from": "flee", "to": "shelter", "when": {"not": {"threat_within_m": "${calm_m}"}}},
    {"from": "shelter", "to": "idle", "when": {"all": [{"is_day": true}, {"temperature_between_c": ["${min_temp_c}", "${max_temp_c}"]}]}},
    {"from": "idle", "to": "shelter", "when": {"any": [{"is_day": false}, {"not": {"temperature_between_c": ["${min_temp_c}", "${max_temp_c}"]}}]}, "priority": 20},
    {"from": "idle", "to": "forage", "when": {"all": [{"need": "hunger", "gt": 0.5}, {"food_within_m": "${food_m}", "tag": "${food_tag}"}]}},
    {"from": "idle", "to": "wander", "when": {"chance": 0.2}},
    {"from": "wander", "to": "idle", "when": {"chance": 0.3}},
    {"from": "forage", "to": "idle", "when": {"need": "hunger", "lt": 0.2}}
  ]
}
