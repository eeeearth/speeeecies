{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-garter-snake-v1",
  "kind": "fsm",
  "description": "Diurnal ectotherm (western terrestrial garter snake): warms up by basking in the open, forages on the ground and in shallow water for worms, slugs, insects, frogs and small fish, drinks, and retreats to a burrow or other cover to rest through the night. A disturbed snake flees. No shared program fits: the ground forager is written for a furred, endothermic mammal (it has no basking state, which is how an ectotherm spends its day, and its flee/forage gaits default to a four-legged gallop/walk rather than a slither); the anuran program assumes nocturnal pond life, the songbird assumes flight and perching, and the seabird assumes a marine colony.",
  "params": {
    "flee_m": 4,
    "calm_m": 12,
    "food_tag": "invertebrate",
    "food_m": 8,
    "water_m": 30,
    "forage_gait": "slither",
    "night_lo_deg": -90,
    "night_hi_deg": -3
  },
  "initial": "bask",
  "states": {
    "bask": {
      "action": {
        "do": "rest"
      },
      "min_dwell_s": 180
    },
    "forage": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "${forage_gait}"
      }
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "${forage_gait}"
      }
    },
    "drink": {
      "action": {
        "do": "drink_nearest",
        "gait": "${forage_gait}"
      }
    },
    "shelter": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 600
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "${forage_gait}"
      },
      "min_dwell_s": 3
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    },
    "accept": {
      "action": {
        "do": "accept_offer"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.2
      },
      "priority": 90
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 60
    },
    {
      "from": "*",
      "to": "accept",
      "when": {
        "all": [
          {
            "player_offer": "food"
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 40
    },
    {
      "from": "touched",
      "to": "bask",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "accept",
      "to": "bask",
      "when": {
        "not": {
          "player_offer": "food"
        }
      }
    },
    {
      "from": "flee",
      "to": "bask",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "bask",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "drink",
      "when": {
        "all": [
          {
            "need": "thirst",
            "gt": 0.6
          },
          {
            "water_within_m": "${water_m}"
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "shelter",
      "when": {
        "any": [
          {
            "need": "energy",
            "gt": 0.7
          },
          {
            "sun_elevation_between_deg": [
              "${night_lo_deg}",
              "${night_hi_deg}"
            ]
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "wander",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "forage",
      "to": "bask",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "wander",
      "to": "bask",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "wander",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "drink",
      "to": "bask",
      "when": {
        "need": "thirst",
        "lt": 0.1
      }
    },
    {
      "from": "shelter",
      "to": "bask",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_lo_deg}",
                "${night_hi_deg}"
              ]
            }
          }
        ]
      }
    }
  ]
}
