{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-bananaquit-v1",
  "kind": "bt",
  "description": "Small nectar-feeding perching passerine (bananaquit). Flees to a perch when threatened, perches and rests in shrub shelter at night, sings from a perch in daylight all year, builds a domed nest at any month, and feeds on nectar by short hops among flowers, perching between feeding bouts. Shared perching-songbird program adapted for year-round breeding, daytime song and nectar feeding; it does not use the shared program's April-May nesting window or dawn-dusk-only song.",
  "params": {
    "flee_m": 4,
    "food_tag": "nectar",
    "song": "song",
    "alarm": "alarm",
    "song_cooldown_s": 8
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "alarm",
              "call": "${alarm}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "fly_to_nearest",
              "tag": "perch"
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_touch": true
            }
          },
          {
            "act": {
              "do": "tolerate_touch"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "fear",
              "gt": 0.2
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "perch_nearest",
              "tag": "shelter"
            }
          },
          {
            "act": {
              "do": "rest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": true
            }
          },
          {
            "cond": {
              "perch_within_m": 30
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          },
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {
              "act": {
                "do": "sing",
                "call": "${song}"
              }
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "nest",
              "gt": 0.5
            }
          },
          {
            "cond": {
              "nest_site_within_m": 40
            }
          },
          {
            "act": {
              "do": "build_nest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.4
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${food_tag}",
              "gait": "hop"
            }
          }
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {
              "act": {
                "do": "take_off"
              }
            },
            {
              "act": {
                "do": "fly_to_nearest",
                "tag": "perch"
              }
            },
            {
              "act": {
                "do": "perch_nearest"
              }
            }
          ]
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
