      "description": "A clear, whistled two-note 'fee-bee' (the second note lower), given mainly in late winter and spring."
    },
    {
      "call_id": "chickadee",
      "context": "Alarm",
      "season_months": [],
      "time_windows": [],
      "cooldown_s": 3,
      "loudness": "Moderate",
      "description": "The namesake 'chick-a-dee-dee-dee': the number of trailing 'dee' notes rises with the size of the threat, and it mobs owls and hawks."
    },
    {
      "call_id": "chick_a_dee",
      "context": "Contact",
      "season_months": [],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 6,
      "loudness": "Moderate",
      "description": "The familiar 'chick-a-dee-dee-dee' call, used as a contact call within flocks and to mob predators; more 'dee' notes signal higher alarm."
    },
    {
      "call_id": "song",
      "context": "Song",
      "season_months": [
        2,
        3,
        4,
        5,
        6
      ],
      "time_windows": [
        "DawnChorus",
        "Day"
      ],
      "cooldown_s": 10,
      "loudness": "Moderate",
      "description": "Clear two-note whistled 'fee-bee' (or three-note 'fee-bee-ee'), given by males from a high perch in the breeding season.",
      "freq_hz": [
        400,
        1400
      ]
    },
    {
      "call_id": "alarm",
      "context": "Alarm",
      "season_months": [],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 4,
      "loudness": "Loud",
      "description": "High-pitched, thin 'zee' or 'see' notes given when a predator is close, often mixed into the chick-a-dee call."
    },
    {
      "call_id": "call",
      "context": "Chirp",
      "season_months": [],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 5,
      "loudness": "Loud",
      "description": "The familiar 'chick-a-dee-dee-dee' that gave the bird its name, made up of up to four units - A, B and C variations of 'chick-a' and D the repeated 'dee' - and produced by both sexes all year. The number of 'dee' notes rises with the urgency of the message, from contact calls in dense vegetation to recruitment of the flock against a predator.",
      "freq_hz": [
        3000,
        8000
      ]
    },
    {
      "call_id": "hiss",
      "context": "Alarm",
      "season_months": [
        5,
        6
      ],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 30,
      "loudness": "Moderate",
      "description": "An explosive hiss like a snake's, given by an incubating female when something unusual disturbs her at the nest entrance; probably an adaptation that discourages nest predators."
    },
    {
      "call_id": "fee_bee",
      "context": "Song",
      "season_months": [],
      "time_windows": [
        "DawnChorus",
        "Day"
      ],
      "cooldown_s": 8,
      "loudness": "Loud",
      "description": "Two clear whistles, the second about a third higher than the first. The song typically starts around 400 Hz with tones spanning roughly 1 kHz, and males sing it only in relative isolation from other chickadees."
    },
    {
      "call_id": "chickadee_dee",
      "context": "Alarm",
      "season_months": [],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 4,
      "loudness": "Loud",
      "description": "The chick-a-dee-dee-dee call, produced by both sexes year round. The number of dee notes tracks the level of threat: usually two, but four or more for a serious threat, and one recorded warning about a pygmy owl carried 23 dees. Other species in a mixed flock respond to it."
    },
    {
      "call_id": "gargle",
      "context": "Contact",
      "season_months": [],
      "time_windows": [
        "Day"
      ],
      "cooldown_s": 6,
      "loudness": "Quiet",
      "description": "A gargle noise used by males as a threat of attacking another male, often when feeding, and also in sexual contexts; chicks learn it soon after birth."
    }
  ],
