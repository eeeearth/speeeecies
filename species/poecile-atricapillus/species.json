  "seasonal": {
    "strategy": "ActiveYearRound",
    "phases": [
      {
        "name": "breeding",
        "start": "04-01",
        "end": "07-31",
        "note": "Excavates or adopts a cavity and raises one brood from April."
      },
      {
        "name": "young",
        "start": "05-01",
        "end": "08-31",
        "note": "Young fledge after about 16 days and follow the adults for several weeks."
      },
      {
        "name": "caching",
        "start": "09-01",
        "end": "11-30",
        "note": "Stores seeds and insects singly in bark and crevices through the autumn."
      },
      {
        "name": "flocking",
        "start": "08-01",
        "end": "03-31",
        "note": "Forms mixed-species winter flocks with nuthatches, titmice and woodpeckers."
      },
      {
        "name": "nesting",
        "start": "04-20",
        "end": "06-30",
        "note": "A cavity nest 1-7 m above ground, excavated by both sexes or taken from a natural cavity, an old woodpecker nest or a nest box; the female builds it of coarse moss or bark strips lined with fine mammal hair. Usually six to eight eggs, incubated by the female alone for 11-14 days while the male feeds her; young leave the nest 12-16 days after hatching."
      },
      {
        "name": "moult",
        "start": "07-15",
        "end": "09-30",
        "note": "Postnuptial moult at the end of the first summer is partial, covering only body feathers and wing coverts; in later years it is complete. Moultting birds stay silent and hidden."
      }
    ],
