{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-western-grey-kangaroo-v1",
  "kind": "fsm",
  "description": "Species-local adaptation for a wild grey kangaroo: grazes using hopping locomotion, rests in shade during daylight, and flees threats. It does not model direct contact or hand feeding.",
  "params": {
    "flee_m": 20,
    "calm_m": 40,
    "food_tag": "graze",
    "food_m": 40,
    "flee_gait": "hop",
    "forage_gait": "hop",
    "rest_sun_lo_deg": 10,
    "rest_sun_hi_deg": 90
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "${forage_gait}"
      }
    },
    "forage": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "${forage_gait}"
      }
    },
    "drink": {
      "action": {
        "do": "drink_nearest",
        "gait": "${forage_gait}"
      }
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "${flee_gait}"
      },
      "min_dwell_s": 3
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.2
      },
      "priority": 90
    },
    {
      "from": "*",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "idle",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "drink",
      "when": {
        "all": [
          {
            "need": "thirst",
            "gt": 0.6
          },
          {
            "water_within_m": 60
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "any": [
          {
            "need": "energy",
            "gt": 0.7
          },
          {
            "sun_elevation_between_deg": [
              "${rest_sun_lo_deg}",
              "${rest_sun_hi_deg}"
            ]
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "wander",
      "when": {
        "chance": 0.25
      }
    },
    {
      "from": "wander",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "forage",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "drink",
      "to": "idle",
      "when": {
        "need": "thirst",
        "lt": 0.1
      }
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${rest_sun_lo_deg}",
                "${rest_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    }
  ]
}
