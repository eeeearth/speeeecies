{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-gopher-snake-v1",
  "kind": "fsm",
  "description": "Diurnal, ground-dwelling, limbless ectotherm (gopher snake, Pituophis catenifer): spends the day in the open, forages by slithering to find small rodents, birds, lizards and eggs, and retreats to a burrow or other cover at night (sun below the horizon) or when its energy is high. A disturbed snake flees by slithering. No shared program fits: the ground forager is written for a four-legged, furred, endothermic mammal (walk/gallop gaits, a food tag of invertebrates, and no slithering), and the garter-snake program is written for a water-associated snake with drinking and a semi-aquatic diet. This species-local program keeps the garter-snake structure but removes the drink state and water distances, because no source describes drinking behaviour for the gopher snake, and it uses slither for every gait. Warm-weather night activity, which the NPS describes, is not modelled: the program's night threshold sends the snake to shelter after dark.",
  "params": {
    "food_tag": "small_vertebrate",
    "flee_m": 4,
    "calm_m": 12,
    "food_m": 8,
    "flee_gait": "slither",
    "forage_gait": "slither",
    "night_lo_deg": -90,
    "night_hi_deg": -3
  },
  "initial": "bask",
  "states": {
    "bask": {
      "action": {
        "do": "rest"
      },
      "min_dwell_s": 180
    },
    "forage": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "${forage_gait}"
      }
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "${forage_gait}"
      }
    },
    "shelter": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 600
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "${flee_gait}"
      },
      "min_dwell_s": 3
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    },
    "accept": {
      "action": {
        "do": "accept_offer"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.2
      },
      "priority": 90
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 60
    },
    {
      "from": "*",
      "to": "accept",
      "when": {
        "all": [
          {
            "player_offer": "food"
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 40
    },
    {
      "from": "touched",
      "to": "bask",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "accept",
      "to": "bask",
      "when": {
        "not": {
          "player_offer": "food"
        }
      }
    },
    {
      "from": "flee",
      "to": "bask",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "bask",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "shelter",
      "when": {
        "any": [
          {
            "need": "energy",
            "gt": 0.7
          },
          {
            "sun_elevation_between_deg": [
              "${night_lo_deg}",
              "${night_hi_deg}"
            ]
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "wander",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "forage",
      "to": "bask",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "wander",
      "to": "bask",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "wander",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "shelter",
      "to": "bask",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_lo_deg}",
                "${night_hi_deg}"
              ]
            }
          }
        ]
      }
    }
  ]
}
