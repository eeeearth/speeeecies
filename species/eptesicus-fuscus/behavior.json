{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-aerial-insectivore-v1",
  "kind": "fsm",
  "description": "Microbat: hangs in a cavity or building by day, emerges after dark, cruises between hunting grounds and catches insects on the wing by hovering and by aerial picking, drops to a water surface to drink, and darts away from a threat. No shared program fits: the songbird is a diurnal perching bird that forages on the ground by hops, the ground forager walks a surface and rests in a burrow or den, the anuran is a night amphibian that forages on the ground, and the seabird takes live prey over water. 'fly' carries the cruising, 'hover' carries the hunting, and 'glide' the sines between them.",
  "params": {
    "flee_m": 15,
    "calm_m": 40,
    "food_tag": "invertebrate",
    "food_m": 12,
    "drink_m": 30,
    "hunt_gait": "hover",
    "fly_gait": "fly"
  },
  "initial": "roost",
  "states": {
    "roost": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 60
    },
    "hang": {
      "action": {
        "do": "hide_nearest"
      },
      "min_dwell_s": 10
    },
    "cruise": {
      "action": {
        "do": "wander",
        "gait": "${fly_gait}"
      }
    },
    "hunt": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "${hunt_gait}"
      },
      "min_dwell_s": 20
    },
    "drink": {
      "action": {
        "do": "drink_nearest"
      },
      "min_dwell_s": 5
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "${fly_gait}"
      },
      "min_dwell_s": 2
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          }
        ]
      },
      "priority": 60
    },
    {
      "from": "touched",
      "to": "hang",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "flee",
      "to": "roost",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "roost",
      "to": "cruise",
      "when": {
        "all": [
          {
            "is_day": false
          },
          {
            "need": "hunger",
            "gt": 0.3
          }
        ]
      },
      "priority": 10
    },
    {
      "from": "roost",
      "to": "hang",
      "when": {
        "is_day": false
      },
      "priority": 9
    },
    {
      "from": "roost",
      "to": "hang",
      "when": {
        "any": [
          {
            "is_day": true
          },
          {
            "need": "energy",
            "gt": 0.8
          }
        ]
      },
      "priority": 8
    },
    {
      "from": "hang",
      "to": "cruise",
      "when": {
        "all": [
          {
            "is_day": false
          },
          {
            "need": "hunger",
            "gt": 0.4
          }
        ]
      }
    },
    {
      "from": "hang",
      "to": "roost",
      "when": {
        "all": [
          {
            "need": "energy",
            "gt": 0.7
          },
          {
            "shelter_within_m": 20
          }
        ]
      }
    },
    {
      "from": "cruise",
      "to": "hunt",
      "when": {
        "all": [
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      },
      "priority": 20
    },
    {
      "from": "cruise",
      "to": "drink",
      "when": {
        "all": [
          {
            "need": "thirst",
            "gt": 0.4
          },
          {
            "water_within_m": "${drink_m}"
          }
        ]
      },
      "priority": 18
    },
    {
      "from": "cruise",
      "to": "hang",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "${food_tag}"
        }
      }
    },
    {
      "from": "hunt",
      "to": "cruise",
      "when": {
        "need": "hunger",
        "lt": 0.25
      }
    },
    {
      "from": "hunt",
      "to": "hang",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "${food_tag}"
        }
      }
    },
    {
      "from": "drink",
      "to": "cruise",
      "when": {
        "need": "thirst",
        "lt": 0.2
      }
    },
    {
      "from": "drink",
      "to": "hang",
      "when": {
        "chance": 0.4
      }
    }
  ]
}