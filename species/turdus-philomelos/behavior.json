{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-song-thrush-v1",
  "kind": "bt",
  "description": "Song thrush (Turdus philomelos): a ground forager on open ground that runs and stops, rummaging leaf litter and eating snails and worms (walk gait, not hop). Takes autumn fruit and winter seed when hungry, flees to cover, sings from an elevated perch at dawn, dusk and in daylight in its song months, roosts in shrub cover at night, and builds a cup nest March to July. A shared program does not fit: the perching songbird hops to food and its nest months skip June.",
  "params": {
    "flee_m": 6,
    "food_tag": "invertebrate",
    "song": "song",
    "alarm": "alarm",
    "song_cooldown_s": 8,
    "forage_gait": "walk",
    "flee_gait": "fly"
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {"cond": {"threat_within_m": "${flee_m}"}},
          {"act": {"do": "alarm", "call": "${alarm}"}},
          {"act": {"do": "take_off"}},
          {"act": {"do": "fly_to_nearest", "tag": "perch"}},
          {"act": {"do": "perch_nearest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"player_touch": true}},
          {"act": {"do": "tolerate_touch"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "fear", "gt": 0.2}},
          {"act": {"do": "take_off"}},
          {"act": {"do": "flee", "gait": "${flee_gait}"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"player_offer": "food"}},
          {"cond": {"need": "fear", "lt": 0.2}},
          {"act": {"do": "land"}},
          {"act": {"do": "accept_offer"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"is_day": false}},
          {"act": {"do": "perch_nearest", "tag": "shelter"}},
          {"act": {"do": "rest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"sun_elevation_between_deg": [-6, 12]}},
          {"cond": {"perch_within_m": 30}},
          {"act": {"do": "perch_nearest"}},
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {"act": {"do": "sing", "call": "${song}"}}
          }
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "nest", "gt": 0.5}},
          {"cond": {"month_in": [3, 4, 5, 6, 7]}},
          {"cond": {"nest_site_within_m": 40}},
          {"act": {"do": "build_nest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"cond": {"month_in": [9, 10, 11, 12, 1]}},
          {"act": {"do": "land"}},
          {"act": {"do": "eat_nearest", "tag": "fruit", "gait": "${forage_gait}"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"cond": {"month_in": [10, 11, 12, 1, 2, 3]}},
          {"act": {"do": "land"}},
          {"act": {"do": "eat_nearest", "tag": "seed", "gait": "${forage_gait}"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"act": {"do": "land"}},
          {"act": {"do": "eat_nearest", "tag": "${food_tag}", "gait": "${forage_gait}"}}
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {"act": {"do": "take_off"}},
            {"act": {"do": "fly_to_nearest", "tag": "perch"}},
            {"act": {"do": "perch_nearest"}}
          ]
        }
      },
      {"act": {"do": "idle"}}
    ]
  }
}
