{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-bufflehead-diver-v1",
  "kind": "fsm",
  "description": "Small diving duck (Bufflehead): sits on open water, swims below the surface to forage for aquatic invertebrates, small fish and seeds (eat_nearest with gait swim; the model has no submerged or dive pose, so dives are not depicted), flies between waters, rests on water at night and in idle time, and takes flight from threats. Diurnal: rests on water after dark, where the sun is between night_sun_lo_deg and night_sun_hi_deg. Feeding starts only in daylight (hunger-gated); a bird that is feeding goes to roost on water at dark. ADW reports that winter birds forage through the night, which this program does not model. No songbird perching, hopping or nesting actions; walks on land are not modelled because the species seldom walks on land.",
  "params": {
    "flee_m": 15,
    "calm_m": 30,
    "food_m": 50,
    "night_sun_lo_deg": -90,
    "night_sun_hi_deg": -6
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "patrol": {
      "action": {
        "do": "wander",
        "gait": "fly"
      }
    },
    "dive_invertebrate": {
      "action": {
        "do": "eat_nearest",
        "tag": "invertebrate",
        "gait": "swim"
      }
    },
    "dive_fish": {
      "action": {
        "do": "eat_nearest",
        "tag": "small_vertebrate",
        "gait": "swim"
      }
    },
    "forage_seed": {
      "action": {
        "do": "eat_nearest",
        "tag": "seed",
        "gait": "swim"
      }
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "fly"
      },
      "min_dwell_s": 3
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.25
      },
      "priority": 90
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "idle",
      "to": "dive_invertebrate",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "invertebrate"
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_sun_lo_deg}",
                "${night_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "dive_fish",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "small_vertebrate"
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_sun_lo_deg}",
                "${night_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_seed",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "seed"
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_sun_lo_deg}",
                "${night_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "patrol",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "patrol",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "dive_invertebrate",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "dive_fish",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_seed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "any": [
          {
            "need": "energy",
            "gt": 0.75
          },
          {
            "sun_elevation_between_deg": [
              "${night_sun_lo_deg}",
              "${night_sun_hi_deg}"
            ]
          }
        ]
      }
    },
    {
      "from": "dive_invertebrate",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${night_sun_lo_deg}",
          "${night_sun_hi_deg}"
        ]
      },
      "priority": 80
    },
    {
      "from": "dive_fish",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${night_sun_lo_deg}",
          "${night_sun_hi_deg}"
        ]
      },
      "priority": 80
    },
    {
      "from": "forage_seed",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${night_sun_lo_deg}",
          "${night_sun_hi_deg}"
        ]
      },
      "priority": 80
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${night_sun_lo_deg}",
                "${night_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    }
  ]
}
