{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-bufflehead-diver-v1",
  "kind": "fsm",
  "description": "Small diving duck (Bufflehead): sits on open water, dives and swims to forage for aquatic invertebrates, small fish and seeds, flies between wetlands, rests on water, and takes flight from threats. No songbird perching, hopping or nesting actions; walks on land are not modelled because the species seldom walks on land.",
  "params": {
    "flee_m": 15,
    "calm_m": 30,
    "food_m": 50
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "patrol": {
      "action": {
        "do": "wander",
        "gait": "fly"
      }
    },
    "dive_invertebrate": {
      "action": {
        "do": "eat_nearest",
        "tag": "invertebrate",
        "gait": "swim"
      }
    },
    "dive_fish": {
      "action": {
        "do": "eat_nearest",
        "tag": "small_vertebrate",
        "gait": "swim"
      }
    },
    "forage_seed": {
      "action": {
        "do": "eat_nearest",
        "tag": "seed",
        "gait": "swim"
      }
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "fly"
      },
      "min_dwell_s": 3
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.25
      },
      "priority": 90
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "idle",
      "to": "dive_invertebrate",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "invertebrate"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "dive_fish",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "small_vertebrate"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_seed",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.45
          },
          {
            "food_within_m": "${food_m}",
            "tag": "seed"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "patrol",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "patrol",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "dive_invertebrate",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "dive_fish",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_seed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "need": "energy",
        "gt": 0.75
      }
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "need": "energy",
        "lt": 0.2
      }
    }
  ]
}
