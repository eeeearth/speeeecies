    "phases": [
      {
        "name": "breeding",
        "start": "04-01",
        "end": "08-31",
        "region": "US-NC",
        "note": "Breeds in coniferous and mixed forests at higher elevations; two broods."
      },
      {
        "name": "flocking",
        "start": "10-01",
        "end": "03-31",
        "note": "Forms winter flocks of 10-30 birds; forages on ground in open areas, yards, and woodland edges."
      },
      {
        "name": "absent",
        "start": "04-15",
        "end": "10-15",
        "region": "CA",
        "fraction": 0.7,
        "note": "Northern breeding populations migrate south for winter; Appalachian birds are largely resident."
      },
      {
        "name": "dispersal",
        "start": "03-15",
        "end": "04-30",
        "note": "'leaving to breed from mid-March onwards, with almost all of them gone by the end of April or so.' Many populations are permanent residents or altitudinal migrants instead - in the Sierra Nevada, eastern California, J. hyemalis winters 5,000-7,000 feet (1,500-2,100 m) below its summer range - and in cold years birds may stay on their winter range and breed there."
      },
      {
        "name": "breeding",
        "start": "04-01",
        "end": "07-31",
        "region": "US-CO",
        "note": "'The dark-eyed junco's breeding habitat is coniferous or mixed forest areas throughout North America.' Nesting starts soon after the return; normally two clutches of four eggs. The slightly glossy eggs are grayish or pale bluish-white and heavily spotted with shades of brown, purple or gray, concentrated at the large end; the female incubates for 12 to 13 days and the young leave the nest between 11 and 14 days after hatching."
      },
      {
        "name": "nesting",
        "start": "04-01",
        "end": "07-31",
        "note": "Nests are usually 'a cup-shaped depression on the ground, well-hidden by vegetation or other material, although nests are sometimes found in the lower branches of a shrub or tree', about 10 cm across and lined with fine grasses and hair."
      }
    ],
