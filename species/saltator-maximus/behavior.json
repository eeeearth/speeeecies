{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-saltator-maximus-v1",
  "kind": "bt",
  "description": "Local variant of bt-perching-songbird-v1 for Saltator maximus: the nesting window is set to March through August, the Costa Rican breeding season the shared program cannot express (it hard-codes April and May). Otherwise as the shared songbird: flee to a perch, sing from a perch at dawn and dusk, roost at night, forage by hops, re-perch.",
  "params": {
    "flee_m": 6,
    "food_tag": "invertebrate",
    "song": "song",
    "alarm": "alarm",
    "song_cooldown_s": 30
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "alarm",
              "call": "${alarm}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "fly_to_nearest",
              "tag": "perch"
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_touch": true
            }
          },
          {
            "act": {
              "do": "tolerate_touch"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "fear",
              "gt": 0.2
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_offer": "food"
            }
          },
          {
            "cond": {
              "need": "fear",
              "lt": 0.2
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "accept_offer"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "perch_nearest",
              "tag": "shelter"
            }
          },
          {
            "act": {
              "do": "rest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "sun_elevation_between_deg": [
                -6,
                12
              ]
            }
          },
          {
            "cond": {
              "perch_within_m": 30
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          },
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {
              "act": {
                "do": "sing",
                "call": "${song}"
              }
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "nest",
              "gt": 0.5
            }
          },
          {
            "cond": {
              "month_in": [
                3,
                4,
                5,
                6,
                7,
                8
              ]
            }
          },
          {
            "cond": {
              "nest_site_within_m": 40
            }
          },
          {
            "act": {
              "do": "build_nest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.4
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${food_tag}",
              "gait": "hop"
            }
          }
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {
              "act": {
                "do": "take_off"
              }
            },
            {
              "act": {
                "do": "fly_to_nearest",
                "tag": "perch"
              }
            },
            {
              "act": {
                "do": "perch_nearest"
              }
            }
          ]
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
