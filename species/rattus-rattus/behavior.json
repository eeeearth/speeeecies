{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-black-rat-v1",
  "kind": "fsm",
  "description": "Nocturnal black rat: walks while roaming and feeding on invertebrates or carrion, climbs while feeding on fruit or seeds, flees at a trot, drinks, and rests in shelter during daylight. Each recorded food-resource category has a reachable feeding action.",
  "params": {
    "flee_m": 5,
    "calm_m": 12,
    "food_m": 20,
    "rest_sun_lo_deg": 10,
    "rest_sun_hi_deg": 90
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "walk"
      }
    },
    "drink": {
      "action": {
        "do": "drink_nearest",
        "gait": "walk"
      }
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "trot"
      },
      "min_dwell_s": 3
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    },
    "accept": {
      "action": {
        "do": "accept_offer"
      }
    },
    "forage_fruit": {
      "action": {
        "do": "eat_nearest",
        "tag": "fruit",
        "gait": "climb"
      }
    },
    "forage_seed": {
      "action": {
        "do": "eat_nearest",
        "tag": "seed",
        "gait": "climb"
      }
    },
    "forage_invertebrate": {
      "action": {
        "do": "eat_nearest",
        "tag": "invertebrate",
        "gait": "walk"
      }
    },
    "forage_carrion": {
      "action": {
        "do": "eat_nearest",
        "tag": "carrion",
        "gait": "walk"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.2
      },
      "priority": 90
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 60
    },
    {
      "from": "*",
      "to": "accept",
      "when": {
        "all": [
          {
            "player_offer": "food"
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 40
    },
    {
      "from": "touched",
      "to": "idle",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "accept",
      "to": "idle",
      "when": {
        "not": {
          "player_offer": "food"
        }
      }
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "idle",
      "to": "forage_fruit",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "fruit"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_seed",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "seed"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_invertebrate",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "invertebrate"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_carrion",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "carrion"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "drink",
      "when": {
        "all": [
          {
            "need": "thirst",
            "gt": 0.6
          },
          {
            "water_within_m": 60
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "any": [
          {
            "need": "energy",
            "gt": 0.7
          },
          {
            "sun_elevation_between_deg": [
              "${rest_sun_lo_deg}",
              "${rest_sun_hi_deg}"
            ]
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "wander",
      "when": {
        "chance": 0.25
      }
    },
    {
      "from": "wander",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "drink",
      "to": "idle",
      "when": {
        "need": "thirst",
        "lt": 0.1
      }
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${rest_sun_lo_deg}",
                "${rest_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    },
    {
      "from": "forage_fruit",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_fruit",
      "to": "idle",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "fruit"
        }
      }
    },
    {
      "from": "forage_seed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_seed",
      "to": "idle",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "seed"
        }
      }
    },
    {
      "from": "forage_invertebrate",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_invertebrate",
      "to": "idle",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "invertebrate"
        }
      }
    },
    {
      "from": "forage_carrion",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_carrion",
      "to": "idle",
      "when": {
        "not": {
          "food_within_m": "${food_m}",
          "tag": "carrion"
        }
      }
    }
  ]
}
