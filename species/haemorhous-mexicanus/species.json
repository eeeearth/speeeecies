    "strategy": "ActiveYearRound",
    "phases": [
      {
        "name": "breeding",
        "start": "03-01",
        "end": "08-31",
        "note": "Breeding from March to August; two to three broods."
      },
      {
        "name": "flocking",
        "start": "09-01",
        "end": "02-28",
        "note": "Winter flocks form outside the breeding season."
      },
      {
        "name": "breeding",
        "start": "02-01",
        "end": "08-31",
        "region": "US-CO",
        "note": "The female lays clutches from February through August, two or more broods per year with 2 to 6 eggs per brood, most commonly 4 or 5, usually one egg per morning. Eggs are pale bluish-green with few black spots; incubation 12-14 days by the female alone; young fledge at about 11 to 19 days after hatching. Analyses of California nest records found egg-laying occurred significantly earlier in warmer springs."
      },
      {
        "name": "nesting",
        "start": "02-01",
        "end": "08-31",
        "note": "The female builds the nest, sometimes in as little as two days, of twigs and debris forming a cup, usually 1.8-2.7 m above the ground in a cavity: an opening in a building, a hanging plant, another cup-shaped outdoor decoration, or a nest abandoned by another bird. Nests may be reused for later broods or in following years."
      },
      {
        "name": "territorial",
        "start": "02-01",
        "end": "08-31",
        "note": "Males hold a breeding territory through courtship and nesting, feeding the female during courtship, breeding and incubation, and raising of the young; the male is the primary feeder of the fledglings."
      },
      {
        "name": "dispersal",
        "start": "09-01",
        "end": "11-30",
        "note": "'House finches are mainly permanent residents throughout their range; some birds migrate to the south, with adult females moving longer distances than males.' No migration window is given in the source, so the window is aligned to the post-breeding period."
      }
    ],
