{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-gray-fox-v1",
  "kind": "fsm",
  "description": "Species-local ground-foraging fox program: hunts small vertebrates, takes invertebrates and fruit when available, drinks and wanders at night, rests at shelter during daylight, and flees threats. Gray foxes climb trees in life, but the kit has no climb action or climb pose, so this program and mesh represent ground activity only.",
  "params": {
    "flee_m": 20,
    "calm_m": 40,
    "food_m": 40,
    "rest_sun_lo_deg": 10,
    "rest_sun_hi_deg": 90
  },
  "initial": "idle",
  "states": {
    "idle": {"action": {"do": "idle"}, "min_dwell_s": 2},
    "wander": {"action": {"do": "wander", "gait": "walk"}},
    "forage_vertebrate": {"action": {"do": "eat_nearest", "tag": "small_vertebrate", "gait": "walk"}},
    "forage_invertebrate": {"action": {"do": "eat_nearest", "tag": "invertebrate", "gait": "walk"}},
    "forage_fruit": {"action": {"do": "eat_nearest", "tag": "fruit", "gait": "walk"}},
    "drink": {"action": {"do": "drink_nearest", "gait": "walk"}},
    "flee": {"action": {"do": "flee", "gait": "gallop"}, "min_dwell_s": 3},
    "rest": {"action": {"do": "rest", "at": "shelter"}, "min_dwell_s": 30},
    "touched": {"action": {"do": "tolerate_touch"}},
    "accept": {"action": {"do": "accept_offer"}}
  },
  "transitions": [
    {"from": "*", "to": "flee", "when": {"threat_within_m": "${flee_m}"}, "priority": 100},
    {"from": "*", "to": "flee", "when": {"need": "fear", "gt": 0.2}, "priority": 90},
    {"from": "*", "to": "touched", "when": {"all": [{"player_touch": true}, {"need": "fear", "lt": 0.2}, {"not": {"threat_within_m": "${flee_m}"}}]}, "priority": 80},
    {"from": "*", "to": "accept", "when": {"all": [{"player_offer": "food"}, {"need": "fear", "lt": 0.2}, {"not": {"threat_within_m": "${flee_m}"}}]}, "priority": 70},
    {"from": "touched", "to": "idle", "when": {"player_touch": false}},
    {"from": "accept", "to": "idle", "when": {"not": {"player_offer": "food"}}},
    {"from": "flee", "to": "idle", "when": {"not": {"threat_within_m": "${calm_m}"}}, "priority": 60},
    {"from": "idle", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "wander", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "forage_vertebrate", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "forage_invertebrate", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "forage_fruit", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "drink", "to": "rest", "when": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}, "priority": 80},
    {"from": "rest", "to": "idle", "when": {"not": {"sun_elevation_between_deg": ["${rest_sun_lo_deg}", "${rest_sun_hi_deg}"]}}, "priority": 60},
    {"from": "idle", "to": "forage_vertebrate", "when": {"all": [{"need": "hunger", "gt": 0.5}, {"food_within_m": "${food_m}", "tag": "small_vertebrate"}]}, "priority": 50},
    {"from": "idle", "to": "forage_invertebrate", "when": {"all": [{"need": "hunger", "gt": 0.5}, {"food_within_m": "${food_m}", "tag": "invertebrate"}]}, "priority": 40},
    {"from": "idle", "to": "forage_fruit", "when": {"all": [{"need": "hunger", "gt": 0.5}, {"food_within_m": "${food_m}", "tag": "fruit"}]}, "priority": 30},
    {"from": "idle", "to": "drink", "when": {"all": [{"need": "thirst", "gt": 0.6}, {"water_within_m": 60}]}, "priority": 20},
    {"from": "idle", "to": "wander", "when": {"chance": 0.25}},
    {"from": "wander", "to": "idle", "when": {"chance": 0.15}},
    {"from": "forage_vertebrate", "to": "idle", "when": {"need": "hunger", "lt": 0.2}},
    {"from": "forage_invertebrate", "to": "idle", "when": {"need": "hunger", "lt": 0.2}},
    {"from": "forage_fruit", "to": "idle", "when": {"need": "hunger", "lt": 0.2}},
    {"from": "drink", "to": "idle", "when": {"need": "thirst", "lt": 0.1}}
  ]
}
