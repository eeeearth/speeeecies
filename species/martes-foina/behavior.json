{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-scansorial-mustelid-v1",
  "kind": "fsm",
  "description": "Species-local program for the stone marten (Martes foina): a nocturnal, solitary, skilled climber and swimmer that hunts mainly on the ground, takes fruit from trees by climbing, crosses water by swimming, flees on foot, and rests in a cavity by day. Walk, gallop, climb and swim are each executed by a state; no shared program executes climb or swim. Judgement: the water-crossing rate (cross_chance) and the distances are authored, not measured.",
  "params": {
    "flee_m": 25,
    "calm_m": 50,
    "food_tag": "small_vertebrate",
    "food_m": 60,
    "canopy_tag": "fruit",
    "canopy_m": 30,
    "water_m": 60,
    "cross_chance": 0.05,
    "ground_gait": "walk",
    "climb_gait": "climb",
    "swim_gait": "swim",
    "flee_gait": "gallop",
    "rest_sun_lo_deg": 10,
    "rest_sun_hi_deg": 90
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "${ground_gait}"
      }
    },
    "forage_ground": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "${ground_gait}"
      }
    },
    "forage_canopy": {
      "action": {
        "do": "eat_nearest",
        "tag": "${canopy_tag}",
        "gait": "${climb_gait}"
      }
    },
    "cross_water": {
      "action": {
        "do": "wander",
        "gait": "${swim_gait}"
      }
    },
    "drink": {
      "action": {
        "do": "drink_nearest",
        "gait": "${ground_gait}"
      }
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "${flee_gait}"
      },
      "min_dwell_s": 3
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    },
    "accept": {
      "action": {
        "do": "accept_offer"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "flee",
      "when": {
        "need": "fear",
        "gt": 0.2
      },
      "priority": 90
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 60
    },
    {
      "from": "*",
      "to": "accept",
      "when": {
        "all": [
          {
            "player_offer": "food"
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 40
    },
    {
      "from": "touched",
      "to": "idle",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "accept",
      "to": "idle",
      "when": {
        "not": {
          "player_offer": "food"
        }
      }
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "wander",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "forage_ground",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "forage_canopy",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "cross_water",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "drink",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          "${rest_sun_lo_deg}",
          "${rest_sun_hi_deg}"
        ]
      },
      "priority": 50
    },
    {
      "from": "idle",
      "to": "forage_ground",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_canopy",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${canopy_m}",
            "tag": "${canopy_tag}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "drink",
      "when": {
        "all": [
          {
            "need": "thirst",
            "gt": 0.6
          },
          {
            "water_within_m": "${water_m}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "cross_water",
      "when": {
        "all": [
          {
            "chance": "${cross_chance}"
          },
          {
            "water_within_m": "${water_m}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "need": "energy",
        "gt": 0.7
      }
    },
    {
      "from": "idle",
      "to": "wander",
      "when": {
        "chance": 0.25
      }
    },
    {
      "from": "wander",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "cross_water",
      "to": "idle",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "forage_ground",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_canopy",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "drink",
      "to": "idle",
      "when": {
        "need": "thirst",
        "lt": 0.1
      }
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "all": [
          {
            "need": "energy",
            "lt": 0.2
          },
          {
            "not": {
              "sun_elevation_between_deg": [
                "${rest_sun_lo_deg}",
                "${rest_sun_hi_deg}"
              ]
            }
          }
        ]
      }
    }
  ]
}
