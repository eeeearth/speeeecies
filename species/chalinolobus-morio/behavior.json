{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-chalinolobus-morio-v1",
  "kind": "fsm",
  "description": "Species-local bat program: roosts during daylight, then wanders and catches flying invertebrates by powered flight after dusk; threats trigger flight away.",
  "params": {
    "flee_m": 15,
    "calm_m": 40,
    "food_m": 40
  },
  "initial": "rest",
  "states": {
    "idle": {"action": {"do": "idle"}, "min_dwell_s": 2},
    "rest": {"action": {"do": "rest", "at": "shelter"}, "min_dwell_s": 30},
    "forage": {"action": {"do": "eat_nearest", "tag": "invertebrate", "gait": "fly"}},
    "wander": {"action": {"do": "wander", "gait": "fly"}},
    "flee": {"action": {"do": "flee", "gait": "fly"}, "min_dwell_s": 3}
  },
  "transitions": [
    {"from": "*", "to": "flee", "when": {"threat_within_m": "${flee_m}"}, "priority": 100},
    {"from": "*", "to": "flee", "when": {"need": "fear", "gt": 0.2}, "priority": 90},
    {"from": "*", "to": "rest", "when": {"sun_elevation_between_deg": [-6, 90]}, "priority": 60},
    {"from": "flee", "to": "idle", "when": {"not": {"threat_within_m": "${calm_m}"}}},
    {"from": "rest", "to": "idle", "when": {"not": {"sun_elevation_between_deg": [-6, 90]}}},
    {"from": "idle", "to": "forage", "when": {"all": [{"need": "hunger", "gt": 0.5}, {"food_within_m": "${food_m}", "tag": "invertebrate"}, {"not": {"sun_elevation_between_deg": [-6, 90]}}]}},
    {"from": "idle", "to": "wander", "when": {"all": [{"chance": 0.25}, {"not": {"sun_elevation_between_deg": [-6, 90]}}]}},
    {"from": "forage", "to": "idle", "when": {"need": "hunger", "lt": 0.2}},
    {"from": "wander", "to": "idle", "when": {"chance": 0.2}}
  ]
}
