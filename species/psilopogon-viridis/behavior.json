{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-psilopogon-viridis-v1",
  "kind": "bt",
  "description": "Species-local tree-feeding barbet behaviour: daytime calling and fruit feeding around tree perches, with cavity nesting and nocturnal roosting. The shared perching-songbird program feeds on the ground by hopping, which does not fit this primarily arboreal frugivore.",
  "params": {
    "song": "song",
    "alarm": "alarm",
    "song_cooldown_s": 8
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {"cond": {"threat_within_m": 6}},
          {"act": {"do": "alarm", "call": "${alarm}"}},
          {"act": {"do": "take_off"}},
          {"act": {"do": "fly_to_nearest", "tag": "perch"}},
          {"act": {"do": "perch_nearest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"is_day": false}},
          {"act": {"do": "perch_nearest", "tag": "cavity"}},
          {"act": {"do": "rest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"sun_elevation_between_deg": [-6, 12]}},
          {"cond": {"perch_within_m": 30}},
          {"act": {"do": "perch_nearest"}},
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {"act": {"do": "sing", "call": "${song}"}}
          }
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "nest", "gt": 0.5}},
          {"cond": {"month_in": [12, 1, 2, 3, 4, 5, 6, 7]}},
          {"cond": {"nest_site_within_m": 40}},
          {"act": {"do": "build_nest"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"act": {"do": "fly_to_nearest", "tag": "fruit"}},
          {"act": {"do": "eat_nearest", "tag": "fruit"}}
        ]
      },
      {
        "sequence": [
          {"cond": {"need": "hunger", "gt": 0.4}},
          {"act": {"do": "fly_to_nearest", "tag": "invertebrate"}},
          {"act": {"do": "eat_nearest", "tag": "invertebrate"}}
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {"act": {"do": "take_off"}},
            {"act": {"do": "fly_to_nearest", "tag": "perch"}},
            {"act": {"do": "perch_nearest"}}
          ]
        }
      },
      {"act": {"do": "idle"}}
    ]
  }
}
