{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-basking-lizard-v1",
  "kind": "fsm",
  "description": "Basking ground lizard: spends the warm part of the day lying in the sun until it is warm enough to be active, forages on the ground for the day's food, and withdraws into cover (logs, rocks, leaf litter) when the temperature falls or the sun goes down. A threat at a distance is met with the deimatic display -- flattening the body, gaping, hissing and showing the blue tongue -- and only a closer threat makes it bolt for cover. Numbers are authored for this species: no shared program models basking, because an ectotherm's activity is gated on its body temperature rather than on hunger and daylight alone.",
  "params": {
    "food_tag": "invertebrate",
    "food_m": 12,
    "flee_m": 6,
    "display_m": 12,
    "calm_m": 15,
    "warm_c": 25,
    "active_c": 35
  },
  "initial": "bask",
  "states": {
    "bask": {
      "action": {
        "do": "rest"
      },
      "min_dwell_s": 30
    },
    "forage": {
      "action": {
        "do": "eat_nearest",
        "tag": "${food_tag}",
        "gait": "walk"
      }
    },
    "wander": {
      "action": {
        "do": "wander",
        "gait": "walk"
      }
    },
    "shelter": {
      "action": {
        "do": "hide_nearest"
      },
      "min_dwell_s": 20
    },
    "display": {
      "action": {
        "do": "alarm",
        "call": "hiss"
      },
      "min_dwell_s": 2
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "walk"
      },
      "min_dwell_s": 2
    },
    "touched": {
      "action": {
        "do": "tolerate_touch"
      }
    },
    "offer": {
      "action": {
        "do": "accept_offer"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "*",
      "to": "display",
      "when": {
        "all": [
          {
            "threat_within_m": "${display_m}"
          },
          {
            "not": {
              "threat_within_m": "${flee_m}"
            }
          }
        ]
      },
      "priority": 50
    },
    {
      "from": "*",
      "to": "touched",
      "when": {
        "all": [
          {
            "player_touch": true
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${display_m}"
            }
          }
        ]
      },
      "priority": 45
    },
    {
      "from": "*",
      "to": "offer",
      "when": {
        "all": [
          {
            "player_offer": "food"
          },
          {
            "need": "fear",
            "lt": 0.2
          },
          {
            "not": {
              "threat_within_m": "${display_m}"
            }
          }
        ]
      },
      "priority": 40
    },
    {
      "from": "display",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      }
    },
    {
      "from": "display",
      "to": "shelter",
      "when": {
        "not": {
          "threat_within_m": "${display_m}"
        }
      }
    },
    {
      "from": "flee",
      "to": "shelter",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "touched",
      "to": "bask",
      "when": {
        "player_touch": false
      }
    },
    {
      "from": "offer",
      "to": "bask",
      "when": {
        "not": {
          "player_offer": "food"
        }
      }
    },
    {
      "from": "bask",
      "to": "shelter",
      "when": {
        "not": {
          "temperature_between_c": [
            "${warm_c}",
            "${active_c}"
          ]
        }
      },
      "priority": 10
    },
    {
      "from": "bask",
      "to": "forage",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.5
          },
          {
            "food_within_m": "${food_m}",
            "tag": "${food_tag}"
          }
        ]
      }
    },
    {
      "from": "bask",
      "to": "wander",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "forage",
      "to": "shelter",
      "when": {
        "not": {
          "temperature_between_c": [
            "${warm_c}",
            "${active_c}"
          ]
        }
      },
      "priority": 10
    },
    {
      "from": "forage",
      "to": "bask",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "wander",
      "to": "shelter",
      "when": {
        "not": {
          "temperature_between_c": [
            "${warm_c}",
            "${active_c}"
          ]
        }
      },
      "priority": 10
    },
    {
      "from": "wander",
      "to": "bask",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "shelter",
      "to": "bask",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "temperature_between_c": [
              "${warm_c}",
              "${active_c}"
            ]
          }
        ]
      }
    }
  ]
}
