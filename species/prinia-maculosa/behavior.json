{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-karoo-prinia-v1",
  "kind": "bt",
  "description": "Karoo prinia: gleans invertebrates by hopping in low scrub, perches in shrubs, gives an alarm call and flies into cover under threat, builds a concealed nest during the South African August-December breeding season, and shelters at night.",
  "params": {
    "flee_m": 6,
    "food_tag": "invertebrate",
    "alarm": "alarm"
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "alarm",
              "call": "${alarm}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "fly_to_nearest",
              "tag": "perch"
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_touch": true
            }
          },
          {
            "act": {
              "do": "tolerate_touch"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "fear",
              "gt": 0.2
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_offer": "food"
            }
          },
          {
            "cond": {
              "need": "fear",
              "lt": 0.2
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "accept_offer"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "perch_nearest",
              "tag": "shelter"
            }
          },
          {
            "act": {
              "do": "rest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "nest",
              "gt": 0.5
            }
          },
          {
            "cond": {
              "month_in": [
                8,
                9,
                10,
                11,
                12
              ]
            }
          },
          {
            "cond": {
              "nest_site_within_m": 40
            }
          },
          {
            "act": {
              "do": "build_nest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.4
            }
          },
          {
            "act": {
              "do": "land"
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${food_tag}",
              "gait": "hop"
            }
          }
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "sequence": [
            {
              "act": {
                "do": "take_off"
              }
            },
            {
              "act": {
                "do": "fly_to_nearest",
                "tag": "perch"
              }
            },
            {
              "act": {
                "do": "perch_nearest"
              }
            }
          ]
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
