{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-wood-duck-v1",
  "kind": "fsm",
  "description": "Diurnal wood ducks dabble for aquatic plants and invertebrates, forage on shore, swim, walk, perch and fly; the simplified FSM rests at water after dark and permits nest-building across an authored US-wide January-July nesting window.",
  "params": {
    "flee_m": 15,
    "food_m": 35,
    "calm_m": 45
  },
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "swim_feed": {
      "action": {
        "do": "eat_nearest",
        "tag": "invertebrate",
        "gait": "swim"
      }
    },
    "shore_feed": {
      "action": {
        "do": "eat_nearest",
        "tag": "seed",
        "gait": "walk"
      }
    },
    "swim": {
      "action": {
        "do": "wander",
        "gait": "swim"
      }
    },
    "walk": {
      "action": {
        "do": "wander",
        "gait": "walk"
      }
    },
    "fly": {
      "action": {
        "do": "wander",
        "gait": "fly"
      }
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "fly"
      },
      "min_dwell_s": 3
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    },
    "nest": {
      "action": {
        "do": "build_nest"
      },
      "min_dwell_s": 10
    },
    "fruit_feed": {
      "action": {
        "do": "eat_nearest",
        "tag": "fruit",
        "gait": "walk"
      }
    },
    "perch": {
      "action": {
        "do": "perch_nearest",
        "tag": "perch"
      },
      "min_dwell_s": 5
    },
    "water_plant_feed": {
      "action": {
        "do": "eat_nearest",
        "tag": "browse",
        "gait": "swim"
      }
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": "${flee_m}"
      },
      "priority": 100
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": "${calm_m}"
        }
      }
    },
    {
      "from": "*",
      "to": "rest",
      "when": {
        "is_day": false
      },
      "priority": 50
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "is_day": true
      }
    },
    {
      "from": "idle",
      "to": "swim_feed",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "need": "hunger",
            "gt": 0.35
          },
          {
            "food_within_m": "${food_m}",
            "tag": "invertebrate"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "shore_feed",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "need": "hunger",
            "gt": 0.35
          },
          {
            "food_within_m": "${food_m}",
            "tag": "seed"
          }
        ]
      }
    },
    {
      "from": "swim_feed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.15
      }
    },
    {
      "from": "shore_feed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.15
      }
    },
    {
      "from": "idle",
      "to": "swim",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "chance": 0.2
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "walk",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "chance": 0.15
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "fly",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "chance": 0.08
          }
        ]
      }
    },
    {
      "from": "swim",
      "to": "idle",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "walk",
      "to": "idle",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "fly",
      "to": "idle",
      "when": {
        "chance": 0.25
      }
    },
    {
      "from": "idle",
      "to": "nest",
      "when": {
        "all": [
          {
            "need": "nest",
            "gt": 0.5
          },
          {
            "month_in": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ]
          },
          {
            "nest_site_within_m": 40
          }
        ]
      }
    },
    {
      "from": "nest",
      "to": "idle",
      "when": {
        "any": [
          {
            "need": "nest",
            "lt": 0.1
          },
          {
            "not": {
              "month_in": [
                1,
                2,
                3,
                4,
                5,
                6,
                7
              ]
            }
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "fruit_feed",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "need": "hunger",
            "gt": 0.35
          },
          {
            "food_within_m": "${food_m}",
            "tag": "fruit"
          }
        ]
      }
    },
    {
      "from": "fruit_feed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.15
      }
    },
    {
      "from": "idle",
      "to": "perch",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "perch_within_m": 30
          },
          {
            "chance": 0.12
          }
        ]
      }
    },
    {
      "from": "perch",
      "to": "idle",
      "when": {
        "any": [
          {
            "need": "hunger",
            "gt": 0.4
          },
          {
            "threat_within_m": "${flee_m}"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "water_plant_feed",
      "when": {
        "all": [
          {
            "is_day": true
          },
          {
            "need": "hunger",
            "gt": 0.35
          },
          {
            "food_within_m": "${food_m}",
            "tag": "browse"
          }
        ]
      }
    },
    {
      "from": "water_plant_feed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.15
      }
    }
  ]
}
