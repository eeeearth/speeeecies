{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "fsm-anas-acuta-v1",
  "kind": "fsm",
  "description": "Northern pintail: rests in daytime and makes short shore and shallow-water feeding bouts mainly in evening and at night; swims while dabbling, walks between water and shore, and flies to escape threats. Dabbling posture itself is not animated.",
  "initial": "idle",
  "states": {
    "idle": {
      "action": {
        "do": "idle"
      },
      "min_dwell_s": 2
    },
    "walk": {
      "action": {
        "do": "wander",
        "gait": "walk"
      }
    },
    "forage_seed": {
      "action": {
        "do": "eat_nearest",
        "tag": "seed",
        "gait": "swim"
      }
    },
    "forage_invertebrate": {
      "action": {
        "do": "eat_nearest",
        "tag": "invertebrate",
        "gait": "swim"
      }
    },
    "flee": {
      "action": {
        "do": "flee",
        "gait": "fly"
      },
      "min_dwell_s": 3
    },
    "rest": {
      "action": {
        "do": "rest",
        "at": "shelter"
      },
      "min_dwell_s": 30
    }
  },
  "transitions": [
    {
      "from": "*",
      "to": "flee",
      "when": {
        "threat_within_m": 25
      },
      "priority": 100
    },
    {
      "from": "flee",
      "to": "idle",
      "when": {
        "not": {
          "threat_within_m": 50
        }
      }
    },
    {
      "from": "idle",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          -6,
          90
        ]
      }
    },
    {
      "from": "rest",
      "to": "idle",
      "when": {
        "not": {
          "sun_elevation_between_deg": [
            -6,
            90
          ]
        }
      }
    },
    {
      "from": "idle",
      "to": "forage_seed",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.4
          },
          {
            "food_within_m": 40,
            "tag": "seed"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "forage_invertebrate",
      "when": {
        "all": [
          {
            "need": "hunger",
            "gt": 0.4
          },
          {
            "food_within_m": 40,
            "tag": "invertebrate"
          }
        ]
      }
    },
    {
      "from": "idle",
      "to": "walk",
      "when": {
        "chance": 0.15
      }
    },
    {
      "from": "walk",
      "to": "idle",
      "when": {
        "chance": 0.2
      }
    },
    {
      "from": "forage_seed",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "forage_invertebrate",
      "to": "idle",
      "when": {
        "need": "hunger",
        "lt": 0.2
      }
    },
    {
      "from": "walk",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          -6,
          90
        ]
      }
    },
    {
      "from": "forage_seed",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          -6,
          90
        ]
      }
    },
    {
      "from": "forage_invertebrate",
      "to": "rest",
      "when": {
        "sun_elevation_between_deg": [
          -6,
          90
        ]
      }
    }
  ]
}
