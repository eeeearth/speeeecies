{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-sturnella-magna-v1",
  "kind": "bt",
  "description": "Eastern meadowlark, species-local: walks and probes the ground for insects and seeds, roosts on the ground in grass, sings from a fence post or perch in spring and summer, builds a ground nest in late spring and summer, and flushes low in flight to a perch when threatened.",
  "params": {
    "flee_m": 6,
    "food_tag": "invertebrate",
    "song": "song",
    "song_cooldown_s": 20
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "fly_to_nearest",
              "tag": "perch"
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "player_touch": true
            }
          },
          {
            "act": {
              "do": "tolerate_touch"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "fear",
              "gt": 0.2
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "rest",
              "at": "shelter"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "month_in": [
                3,
                4,
                5,
                6,
                7,
                8
              ]
            }
          },
          {
            "cond": {
              "sun_elevation_between_deg": [
                -6,
                12
              ]
            }
          },
          {
            "cond": {
              "perch_within_m": 30
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          },
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {
              "act": {
                "do": "sing",
                "call": "${song}"
              }
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "nest",
              "gt": 0.5
            }
          },
          {
            "cond": {
              "month_in": [
                5,
                6,
                7,
                8
              ]
            }
          },
          {
            "cond": {
              "nest_site_within_m": 40
            }
          },
          {
            "act": {
              "do": "build_nest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.4
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${food_tag}",
              "gait": "walk"
            }
          }
        ]
      },
      {
        "cooldown_s": 6,
        "child": {
          "act": {
            "do": "wander",
            "gait": "walk"
          }
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
