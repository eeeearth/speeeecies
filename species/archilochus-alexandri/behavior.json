{
  "schema_version": 1,
  "format": "speeeecies/behavior",
  "id": "bt-hovering-hummingbird-v1",
  "kind": "bt",
  "description": "Small hummingbird: flee by flight, hover-feed at nectar, catch small insects, perch to rest at night, sing/chirp from exposed perches and build a cup nest in shrubs or trees.",
  "params": {
    "flee_m": 4,
    "nectar_tag": "nectar",
    "insect_tag": "invertebrate",
    "song": "chirp",
    "alarm": "chirp",
    "song_cooldown_s": 10,
    "nest_m1": 4,
    "nest_m2": 7
  },
  "root": {
    "selector": [
      {
        "sequence": [
          {
            "cond": {
              "threat_within_m": "${flee_m}"
            }
          },
          {
            "act": {
              "do": "alarm",
              "call": "${alarm}"
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "flee",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "is_day": false
            }
          },
          {
            "act": {
              "do": "perch_nearest",
              "tag": "shelter"
            }
          },
          {
            "act": {
              "do": "rest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "nest",
              "gt": 0.5
            }
          },
          {
            "cond": {
              "month_in": [
                "${nest_m1}",
                5,
                6,
                "${nest_m2}"
              ]
            }
          },
          {
            "cond": {
              "nest_site_within_m": 30
            }
          },
          {
            "act": {
              "do": "build_nest"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.35
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${nectar_tag}",
              "gait": "hover"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "need": "hunger",
              "gt": 0.25
            }
          },
          {
            "cond": {
              "chance": 0.35
            }
          },
          {
            "act": {
              "do": "take_off"
            }
          },
          {
            "act": {
              "do": "eat_nearest",
              "tag": "${insect_tag}",
              "gait": "fly"
            }
          }
        ]
      },
      {
        "sequence": [
          {
            "cond": {
              "sun_elevation_between_deg": [
                -4,
                18
              ]
            }
          },
          {
            "cond": {
              "perch_within_m": 20
            }
          },
          {
            "act": {
              "do": "perch_nearest"
            }
          },
          {
            "cooldown_s": "${song_cooldown_s}",
            "child": {
              "act": {
                "do": "sing",
                "call": "${song}"
              }
            }
          }
        ]
      },
      {
        "cooldown_s": 5,
        "child": {
          "sequence": [
            {
              "act": {
                "do": "take_off"
              }
            },
            {
              "act": {
                "do": "fly_to_nearest",
                "tag": "perch"
              }
            },
            {
              "act": {
                "do": "perch_nearest"
              }
            }
          ]
        }
      },
      {
        "act": {
          "do": "idle"
        }
      }
    ]
  }
}
